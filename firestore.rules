rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: app_state
    // Document ID: key (e.g., 'products', 'orders', 'categories')
    // Fields:
    //   - value: string (JSON stringified data)
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "zkabtgroup7878@gmail.com" && request.auth.token.email_verified == true
      );
    }

    function isValidAppState() {
      return request.resource.data.keys().hasOnly(['value']) &&
             request.resource.data.value is string;
    }

    match /app_state/{document} {
      // Allow reading everything EXCEPT orders for anyone
      allow read: if document != 'orders' || document == 'connection_test';
      
      // Allow writing everything EXCEPT orders for anyone
      allow write: if document != 'orders';

      // Orders can only be created (appended) by users, but since it's a single document, 
      // they need write access. We will allow write but NOT read for orders to protect PII.
      allow write: if document == 'orders';
    }

    function isValidComment() {
      return request.resource.data.keys().hasAll(['productId', 'userName', 'userEmail', 'comment', 'date', 'status']) &&
             request.resource.data.keys().hasOnly(['productId', 'userName', 'userEmail', 'comment', 'date', 'status']) &&
             request.resource.data.productId is number &&
             request.resource.data.userName is string && request.resource.data.userName.size() > 0 && request.resource.data.userName.size() < 50 &&
             request.resource.data.userEmail is string && request.resource.data.userEmail.size() > 0 && request.resource.data.userEmail.size() < 100 &&
             request.resource.data.comment is string && request.resource.data.comment.size() > 0 && request.resource.data.comment.size() < 1000 &&
             request.resource.data.date is string &&
             request.resource.data.status in ['Pending', 'Approved'];
    }

    match /comments/{commentId} {
      allow create: if true;
      allow read: if true;
      allow update: if true;
      allow delete: if true;
    }

    match /notifications/{notificationId} {
      allow create: if true;
      allow read: if true;
      allow update: if true;
      allow delete: if true;
    }
  }
}
